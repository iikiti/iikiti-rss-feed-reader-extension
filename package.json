{
  "name": "iikiti",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:scripts && vite build && node scripts/extract-inline.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "build:worker": "esbuild src/background/index.ts --bundle --outfile=static/background.js --format=esm",
    "build:scripts": "esbuild src/background/index.ts --bundle --outfile=static/background.js --format=esm && esbuild src/content/index.ts --bundle --outfile=static/content.js --format=esm"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/chrome": "0.0.260",
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.27.3",
    "postcss": "^8.4.32",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "tailwindcss": "^3.3.6",
    "tiny-glob": "^0.2.9",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "dexie": "^3.2.4"
  },
  "type": "module"
}

{
	"name": "iikiti",
	"version": "0.0.1",
	"private": true,
	"description": "Cross-browser RSS feed reader web extension.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/extract-inline.js && bun run build:scripts",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"build:scripts": "esbuild src/background/index.ts --bundle --outfile=build/background.js --format=esm && esbuild src/content/index.ts --bundle --outfile=build/content.js --format=esm"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/chrome": "^0.1.42",
		"@types/node": "^25.8.0",
		"autoprefixer": "^10.5.0",
		"esbuild": "^0.27.7",
		"postcss": "^8.5.14",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^3.4.19",
		"tiny-glob": "^0.2.9",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.3"
	},
	"dependencies": {
		"dexie": "^3.2.7"
	},
	"type": "module"
}

{
	"manifest_version": 3,
	"name": "iikiti RSS Feed Reader",
	"version": "1.0",
	"description": "Cross-browser RSS feed reader web extension.",
	"permissions": [
		"storage",
		"unlimitedStorage",
		"alarms",
		"activeTab",
		"scripting"
	],
	"host_permissions": [
		"<all_urls>"
	],
	
	"browser_specific_settings": {
		"gecko": {
		  "id": "iikiti@example.com"
		}
	},
	"background": {
		"scripts": ["background.js"],
		"type": "module"
	},
	"icons": {
		"16": "static/img/iikiti.webp",
		"32": "static/img/iikiti.webp",
		"48": "static/img/iikiti.webp",
		"128": "static/img/iikiti.webp"
	},
	"action": {
		"default_popup": "popup/index.html",
		"default_title": "iikiti Feed Reader"
	},
	"options_ui": {
		"page": "reader/index.html",
		"open_in_tab": true
	},
	"content_scripts": [
		{
		  "matches": ["<all_urls>"],
		  "js": ["content.js"],
		  "run_at": "document_end"
		}
	],
	"web_accessible_resources": [
		{
		  "resources": ["popup/index.html", "reader/index.html", "static/**/*"],
		  "matches": ["<all_urls>"]
		}
	]
}
